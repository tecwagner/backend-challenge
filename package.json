{
  "name": "wagering-processor",
  "version": "0.0.1",
  "description": "Distributed wagering processor service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun --packages external",
    "start": "bun run dist/main.js",
    "test": "bun test",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "migration:run": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down",
    "migration:status": "bun src/infrastructure/persistence/migrate.ts status",
    "postinstall": "rm -f node_modules/ssh2/lib/protocol/crypto/build/Release/sshcrypto.node node_modules/cpu-features/build/Release/cpufeatures.node"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1157.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/node": "26.6.5",
    "bun-types": "1.4.4",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2"
  }
}
