# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
#
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Desenvolvimento (Docker Compose):
#   DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
#
# Testes de integração (docker-compose.test.yml, porta 5433):
#   DATABASE_URL=postgresql://wagering:wagering@localhost:5433/wagering_test
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

# Timeout de aquisição de lock pessimista (LockMode.PESSIMISTIC_WRITE)
# Se o lock não for adquirido em 5s, retorna HTTP 503
# Referência: design.md §Estratégia de Concorrência
DB_LOCK_TIMEOUT_MS=5000

# Timeout máximo de execução de statement SQL
# Proteção adicional contra queries longas
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# AWS / LocalStack
#
# Para desenvolvimento local, use o endpoint do LocalStack.
# Em produção, remova AWS_ENDPOINT e configure credenciais reais via IAM.
# ---------------------------------------------------------------------------
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1

# Credenciais fictícias para LocalStack (não usar em produção)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---------------------------------------------------------------------------
# Filas SQS (LocalStack)
#
# Account ID do LocalStack: 000000000000
# Em produção, substituir pelo ARN real da conta AWS.
# ---------------------------------------------------------------------------

# Fila principal de transações de apostas
QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo

# Fila de eventos de integração (publicada pelo Outbox Worker)
INTEGRATION_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/integration-events.fifo

# Dead Letter Queue — mensagens que excederam maxReceiveCount (5 tentativas)
DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# ---------------------------------------------------------------------------
# Outbox Publisher Worker
#
# O worker publica eventos pendentes da tabela outbox_messages para o SQS.
# Referência: design.md §Workers — Outbox Publisher Worker
# ---------------------------------------------------------------------------

# Intervalo entre ciclos de polling do Outbox Worker (ms)
OUTBOX_POLL_INTERVAL_MS=1000

# Número máximo de mensagens processadas por ciclo
OUTBOX_BATCH_SIZE=10

# Número máximo de tentativas de publicação antes de abandonar a mensagem
OUTBOX_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Pending Reference Worker
#
# Reprocessa transações no estado PENDING_REFERENCE (referência ausente).
# Referência: design.md §Workers — Pending Reference Worker
# ---------------------------------------------------------------------------

# Expressão cron para o intervalo de reprocessamento
# Padrão: a cada 30 segundos
# Formato: segundos minutos horas dia-do-mês mês dia-da-semana
PENDING_REF_CRON=*/30 * * * * *

# Número máximo de tentativas antes de rejeitar com FailureCode.REFERENCE_EXPIRED
PENDING_REF_MAX_ATTEMPTS=5
